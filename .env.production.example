# HistAR BE — Production (Render + Postgres Render + FE Vercel)
# Copy → Render Dashboard → Web Service → Environment (hoặc copy thành .env.production local)
# KHÔNG commit file có mật khẩu thật.

SPRING_PROFILES_ACTIVE=prod

# --- PostgreSQL (Render) ---
#
# QUAN TRỌNG: Paste vào Render Dashboard → Environment (file local không lên Git).
#
# Bước 1: Render → Web Service → Connections → Link PostgreSQL
# Bước 2: XÓA biến DB_URL manual (nếu có) — để Render inject DATABASE_URL (internal)
# Bước 3: Chỉ set DB_USER + DB_PASSWORD nếu Render chưa inject
#
# Lỗi UnknownHostException → chưa Link DB, đang dùng internal hostname
# Lỗi EOFException khi auth → BE trên Render đang dùng External URL — chuyển sang Link + Internal
#
# DB_URL=jdbc:postgresql://dpg-XXXXX-a:5432/timelens   # chỉ sau khi Link DB
DB_USER=timelens
DB_PASSWORD=YOUR_POSTGRES_PASSWORD

# --- JWT (random ≥ 32 ký tự) ---
JWT_SECRET=YOUR_LONG_RANDOM_JWT_SECRET

# --- CORS: FE Vercel ---
CORS_ALLOWED_ORIGINS=https://fe-lake-five.vercel.app,https://www.fe-lake-five.vercel.app

# --- Chat (Render không có Ollama/AI container — dùng Gemini) ---
CHAT_PROVIDER=gemini
CHAT_HYBRID_ORDER=gemini
HISTORY_AI_ENABLED=false
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash-lite

# --- MinIO / S3-compatible (upload ảnh — cần host riêng, ví dụ MinIO cloud / Railway) ---
# Nếu chưa có: panorama upload / photo-frame sẽ lỗi — có thể bật sau
MINIO_ENDPOINT=https://your-minio-host:9000
MINIO_PUBLIC_URL=https://your-minio-public-url
MINIO_ROOT_USER=your-minio-access-key
MINIO_ROOT_PASSWORD=your-minio-secret-key
MINIO_BUCKET_NAME=timelens-media

# --- Demo GPS check-in (tắt production) ---
DEMO_ENABLED=false
DEMO_SECRET=
