# HistAR BE — Production (Render + Postgres Render + FE Vercel)
# Copy → Render Dashboard → Web Service → Environment (hoặc copy thành .env.production local)
# KHÔNG commit file có mật khẩu thật.

SPRING_PROFILES_ACTIVE=prod

# --- PostgreSQL (Render) ---
#
# QUAN TRỌNG: Paste vào Render Dashboard → Environment (file local không lên Git).
#
# Bước 1: Render → Web Service → Connections → Link PostgreSQL
# Bước 2: XÓA biến DB_URL manual (nếu có) — để Render inject DATABASE_URL (internal)
# Bước 3: Chỉ set DB_USER + DB_PASSWORD nếu Render chưa inject
#
# Lỗi UnknownHostException → chưa Link DB, đang dùng internal hostname
# Lỗi EOFException khi auth → BE trên Render đang dùng External URL — chuyển sang Link + Internal
#
# DB_URL=jdbc:postgresql://dpg-XXXXX-a:5432/timelens   # chỉ sau khi Link DB
DB_USER=timelens
DB_PASSWORD=YOUR_POSTGRES_PASSWORD

# Hikari pool per instance — tổng kết nối ≈ instances × HIKARI_MAX_POOL_SIZE ≤ Postgres connection limit
# Ví dụ: gói 97 connections, 3 instance → đặt 5–10 (để headroom cho admin/migrations)
HIKARI_MAX_POOL_SIZE=5

# Timezone (Render container + cron jobs use Asia/Ho_Chi_Minh in code)
TZ=Asia/Ho_Chi_Minh

# --- JWT (random ≥ 32 ký tự) ---
JWT_SECRET=YOUR_LONG_RANDOM_JWT_SECRET

# --- CORS: FE Vercel ---
CORS_ALLOWED_ORIGINS=https://fe-lake-five.vercel.app,https://www.fe-lake-five.vercel.app

# --- Chat (Render không có Ollama/AI container — dùng Gemini) ---
CHAT_PROVIDER=gemini
CHAT_HYBRID_ORDER=gemini
HISTORY_AI_ENABLED=false
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash-lite

# --- MinIO / S3-compatible (upload ảnh — cần host riêng, ví dụ MinIO cloud / Railway) ---
# Nếu chưa có: panorama upload / photo-frame sẽ lỗi — có thể bật sau
MINIO_ENDPOINT=https://your-minio-host:9000
MINIO_PUBLIC_URL=https://your-minio-public-url
MINIO_ROOT_USER=your-minio-access-key
MINIO_ROOT_PASSWORD=your-minio-secret-key
MINIO_BUCKET_NAME=timelens-media

# Optional survival media probe (scripts/survival-smoke-external.ps1): SURVIVAL_MEDIA_PROBE=1

# --- Demo GPS check-in (tắt production) ---
DEMO_ENABLED=false
DEMO_SECRET=

# --- Test hooks (local/E2E only — set false on public Render after smoke) ---
HISTAR_TEST_HOOKS_ENABLED=false
HISTAR_TEST_HOOKS_SECRET=YOUR_RANDOM_TEST_HOOK_SECRET

# --- SePay B2C payment ---
SEPAY_ENABLED=true
SEPAY_BANK_CODE=MBBank
SEPAY_ACCOUNT_NUMBER=0815330544
SEPAY_ACCOUNT_NAME=DANG THUAN PHAT
SEPAY_WEBHOOK_SECRET=YOUR_SEPAY_WEBHOOK_SECRET
SEPAY_QR_BASE_URL=https://vietqr.app/img
SEPAY_QR_TEMPLATE=compact
SEPAY_QR_SHOW_INFO=true
SEPAY_B2C_PREMIUM_PRICE_VND=49000
SEPAY_ORDER_EXPIRY_MINUTES=15
SEPAY_MAX_TIMESTAMP_SKEW_SECONDS=300

# --- Frontend URL (verify email + org invite deep-link) ---
FRONTEND_URL=https://fe-lake-five.vercel.app

# --- Gmail SMTP (App Password — KHÔNG dùng mật khẩu đăng nhập thường) ---
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_USERNAME=YOUR_GMAIL@gmail.com
MAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD
MAIL_FROM=YOUR_GMAIL@gmail.com

# --- Firebase Admin (project histar-a08c1) ---
FIREBASE_ENABLED=true
# Paste base64 của file service account JSON — xem docs/FIREBASE_AUTH_SETUP.md
FIREBASE_SERVICE_ACCOUNT_JSON=
