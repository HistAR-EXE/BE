POSTGRES_DB=timelens
POSTGRES_USER=timelens
POSTGRES_PASSWORD=timelens_secret
POSTGRES_PORT=5432

DB_URL=jdbc:postgresql://localhost:5432/timelens
DB_USER=timelens
DB_PASSWORD=timelens_secret

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=timelens-media

JWT_SECRET=change-me-to-at-least-32-characters-long
# Chat: hybrid = history-ai -> ollama -> gemini (fallback)
CHAT_PROVIDER=hybrid
CHAT_HYBRID_ORDER=history-ai,ollama,gemini

HISTORY_AI_BASE_URL=http://localhost:8000
HISTORY_AI_ENABLED=true
HISTORY_AI_TIMEOUT_SECONDS=120

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_TIMEOUT_SECONDS=120

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_DAILY_MESSAGE_LIMIT=50

GAMIFICATION_CHECKIN_RADIUS_METERS=100
GAMIFICATION_LEVEL_THRESHOLDS=0,100,300,700

MINIO_PUBLIC_URL=http://localhost:9000
VIRAL_SHARE_BONUS_POINTS=15
VIRAL_LEADERBOARD_LIMIT=50
VIRAL_LEADERBOARD_CACHE_SECONDS=60

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email — local: MAIL_PROVIDER=smtp (Gmail/MailHog) | prod Render: MAIL_PROVIDER=brevo + BREVO_API_KEY
FRONTEND_URL=http://localhost:5173
MAIL_PROVIDER=smtp
MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@histar.vn
# B2B2C inquiry sales notifications (histar.sales-inbox)
SALES_INBOX=sales@yourdomain.com
# BREVO_API_KEY=xkeysib-...   (chỉ khi MAIL_PROVIDER=brevo)
# RESEND_API_KEY=re_...       (optional rollback path)

# Firebase Google login
FIREBASE_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_JSON=

# SePay B2C payment (local)
SEPAY_ENABLED=false
SEPAY_BANK_CODE=MBBank
SEPAY_ACCOUNT_NUMBER=0815330544
SEPAY_ACCOUNT_NAME=DANG THUAN PHAT
SEPAY_WEBHOOK_SECRET=YOUR_SEPAY_WEBHOOK_SECRET
SEPAY_API_KEY=YOUR_SEPAY_API_KEY
SEPAY_WEBHOOK_AUTH_MODE=auto
SEPAY_QR_BASE_URL=https://vietqr.app/img
SEPAY_QR_TEMPLATE=compact
SEPAY_QR_SHOW_INFO=true
SEPAY_B2C_PREMIUM_PRICE_VND=49000
SEPAY_ORDER_EXPIRY_MINUTES=15
SEPAY_EXPIRY_GRACE_MINUTES=30
SEPAY_MAX_TIMESTAMP_SKEW_SECONDS=300

# Production (SPRING_PROFILES_ACTIVE=prod)
# SERVER_PORT=8080
# PORT=8080

# Demo backup — chỉ bật khi rehearse (QR/GPS fail)
DEMO_ENABLED=false
DEMO_SECRET=

# E2E test hooks (local only — set quota without burning 5000 msgs)
HISTAR_TEST_HOOKS_ENABLED=true
HISTAR_TEST_HOOKS_SECRET=dev-test-hook-secret

# Prod / Render: HIKARI_MAX_POOL_SIZE per instance (total ≤ Postgres connection limit)
# HIKARI_MAX_POOL_SIZE=5
# TZ=Asia/Ho_Chi_Minh

# Cloud S3-compatible media (prod) — survival upload probe:
# MINIO_ENDPOINT=... MINIO_PUBLIC_URL=... SURVIVAL_MEDIA_PROBE=1
